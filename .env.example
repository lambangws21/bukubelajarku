# Copy this file to `.env.local` (do NOT commit `.env.local`).

## ===============================
## Firebase Storage (Server API)
## Used by:
## - GET /api/firebase/storage/list
## - GET /api/firebase/storage/download
## ===============================
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# Keep the newline escapes (\\n). The code will convert them to real newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"
FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"

## ===============================
## Firebase Web SDK (Client) – Optional
## Only needed if you use `src/lib/firebase/client.ts` in the browser.
## ===============================
NEXT_PUBLIC_FIREBASE_API_KEY="your-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"
# Web Push key (Firebase Console > Cloud Messaging > Web configuration)
NEXT_PUBLIC_FIREBASE_VAPID_KEY="BPwPg1OQulWKJ24KGisX-OUmuT3UMMWZ2MmPXM-RpKV47JeKtx5DtPWx-IijP0uNCA8qNC1WFrjYZZAr3lJoVI4"

## ===============================
## Google Apps Script (Case / Kasus)
## Used by:
## - /api/addCases/getCases
## - /api/addCases/cases
## ===============================
GAS_CASES_URL="https://script.google.com/macros/s/AKfycbwpJ-zhaYMPVR29sVOzc3D5iiw5IEFGCdQd3S8tYvGRiGCocz29xB10UXHkEdFbRc4P/exec"

## ===============================
## Google Apps Script (TS Support)
## Used by:
## - /api/asistensi/ts-support
## ===============================
GAS_TS_SUPPORT_URL="https://script.google.com/macros/s/AKfycbz6uWrmkveEmr7awZenZwND0LukrefsZUjwoNK3mPuzWa2k566qP54-9QeKlW1Yn945/exec"

## ===============================
## TS Support Session & Auth
## Used by:
## - /api/ts-support-auth/*
## - /app/ts-support (session gate)
## ===============================
# Secret untuk sign cookie session (wajib untuk login)
TS_SUPPORT_SESSION_SECRET="replace-with-long-random-secret"
# Optional: durasi session cookie dalam detik (default 5 tahun)
TS_SUPPORT_SESSION_TTL_SECONDS=""
# Jika diisi, pendaftaran user TS Support wajib menyertakan token ini
TS_SUPPORT_REGISTER_TOKEN=""
# Daftar email yang boleh auto-provision saat login meski profil RTDB belum bisa disimpan
TS_SUPPORT_AUTO_PROVISION_EMAILS=""
# Role mutate data: sales/coordinator/ts/logistik/admin. Role readonly-only: viewer.
# Optional: token RTDB (auth query param) jika rules database tidak public
FIREBASE_DB_AUTH_TOKEN=""
# Optional (disarankan): kredensial service account Firebase dalam 1 JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Optional alternatif: service account JSON dalam base64
# Nilai ini HARUS base64 dari file service account JSON utuh (bukan private key mentah).
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=""
# Optional topic untuk broadcast FCM aktivitas TS Support
FCM_TS_SUPPORT_TOPIC="ts_support_activity"
